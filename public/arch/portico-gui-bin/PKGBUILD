package() {
  local deb
  case "${CARCH}" in
    x86_64) deb="Portico_${pkgver}_amd64.deb" ;;
    aarch64) deb="Portico_${pkgver}_arm64.deb" ;;
  esac
  # A .deb is an ar archive: its payload is data.tar.* (/usr/bin/portico-gui,
  # the desktop entry, hicolor icons).
  bsdtar -xOf "${deb}" 'data.tar.*' | bsdtar -xf - -C "${pkgdir}" --no-same-owner
  install -Dm0644 "LICENSE-MIT-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-MIT"
  install -Dm0644 "LICENSE-APACHE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-APACHE"
}
