---
import type { Dict } from '../i18n/content.ts';
import { diagramRuns } from '../lib/diagram.ts';
interface Props {
  t: Dict;
}
const { t } = Astro.props;
const a = t.architecture;
const parts = ['c', 'd', 'p', 'a'];
const html = diagramRuns()
  .map((runs) =>
    runs
      .map((r) => {
        const text = r.text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        return r.part ? `<span data-p="${r.part}">${text}</span>` : text;
      })
      .join(''),
  )
  .join('\n');
---

<section id="architecture" class="section" aria-labelledby="arch-title">
  <div class="wrap">
    <div class="grid head">
      <p class="meta label col-label" data-reveal>{a.label}</p>
      <div class="col-main">
        <h2 id="arch-title" class="h2" data-reveal>{a.title}</h2>
        <p class="lead" data-reveal data-d="1">{a.lead}</p>
      </div>
    </div>

    <div class="grid body" data-arch data-active="">
      <ol class="points" role="list">
        {
          a.points.map((p, i) => (
            <li>
              <button type="button" class="point" data-part={parts[i]} aria-pressed="false">
                <span class="meta">0{i + 1}</span>
                <span class="k">{p.k}</span>
                <span class="v">{p.v}</span>
              </button>
            </li>
          ))
        }
      </ol>
      <figure class="diagram">
        <div class="scroller" tabindex="0" role="img" aria-label={a.diagramLabel}>
          <pre class="ascii" set:html={html} />
        </div>
        <figcaption class="meta">{a.figure}</figcaption>
      </figure>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-arch]');
  if (root) {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-part]')];
    let pinned: string | null = null;
    const show = (part: string | null) => {
      root.dataset['active'] = part ?? '';
      buttons.forEach((b) => b.classList.toggle('on', b.dataset['part'] === part));
    };
    buttons.forEach((b) => {
      const part = b.dataset['part'] ?? null;
      b.addEventListener('pointerenter', () => show(part));
      b.addEventListener('pointerleave', () => show(pinned));
      b.addEventListener('focus', () => show(part));
      b.addEventListener('blur', () => show(pinned));
      b.addEventListener('click', () => {
        pinned = pinned === part ? null : part;
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset['part'] === pinned)));
        show(pinned);
      });
    });
  }
</script>

<style>
  .col-label {
    grid-column: 1 / span 3;
    padding-top: 0.8em;
    align-self: start;
  }
  .col-main {
    grid-column: 4 / span 8;
    display: grid;
    gap: var(--space-5);
  }
  .body {
    margin-top: clamp(56px, 7vw, 104px);
    align-items: start;
    row-gap: var(--space-6);
  }
  .points {
    grid-column: 1 / span 4;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .point {
    display: grid;
    grid-template-columns: 32px 1fr;
    column-gap: var(--space-3);
    row-gap: var(--space-1);
    width: 100%;
    text-align: left;
    padding: var(--space-4) var(--space-3) var(--space-4) 0;
    border-bottom: 1px solid var(--line);
    border-radius: 0;
    position: relative;
    transition: background-color var(--motion-fast) var(--ease-standard);
  }
  .point::before {
    content: '';
    position: absolute;
    left: -1px;
    top: -1px;
    bottom: -1px;
    width: 2px;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform var(--motion-base) var(--ease-standard);
  }
  .point.on::before {
    transform: none;
  }
  .point .meta {
    grid-row: 1 / span 2;
    padding-top: 3px;
    padding-left: var(--space-3);
  }
  .k {
    font-weight: 600;
    font-size: var(--fs-ui);
  }
  .v {
    grid-column: 2;
    color: var(--text-secondary);
    font-size: var(--fs-ui-sm);
    text-wrap: pretty;
  }
  .point.on .k {
    color: var(--accent);
  }
  .diagram {
    grid-column: 6 / span 7;
    margin: 0;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
    overflow: hidden;
  }
  .scroller {
    container-type: inline-size;
    overflow-x: auto;
    padding: clamp(20px, 3vw, 40px);
  }
  .diagram pre {
    font-size: max(7px, min(15px, calc(100cqi / 66 / 0.6)));
    line-height: 1.32;
    color: var(--text-muted);
    width: max-content;
    margin-inline: auto;
  }
  .diagram pre :global([data-p]) {
    transition:
      color var(--motion-base) var(--ease-standard),
      opacity var(--motion-base) var(--ease-standard);
  }
  .diagram pre :global([data-p='s']) {
    color: var(--border-strong);
  }
  .diagram pre :global([data-p='c']),
  .diagram pre :global([data-p='a']),
  .diagram pre :global([data-p='d']),
  .diagram pre :global([data-p='p']) {
    color: var(--text-secondary);
  }
  [data-arch]:not([data-active='']) pre :global([data-p]) {
    opacity: 0.35;
  }
  [data-arch][data-active='c'] pre :global([data-p='c']),
  [data-arch][data-active='d'] pre :global([data-p='d']),
  [data-arch][data-active='p'] pre :global([data-p='p']),
  [data-arch][data-active='a'] pre :global([data-p='a']) {
    opacity: 1;
    color: var(--accent);
  }
  .diagram figcaption {
    padding: var(--space-3) var(--space-4);
    border-top: 1px solid var(--border-subtle);
  }
  @media (max-width: 1000px) {
    .col-label,
    .col-main,
    .points,
    .diagram {
      grid-column: 1 / -1;
    }
  }
</style>
