---
import type { Dict } from '../i18n/content.ts';
interface Props {
  t: Dict;
}
const { t } = Astro.props;
const r = t.roadmap;
const legend = t.features.legend;
---

<section id="feuille-de-route" class="section" aria-labelledby="roadmap-title">
  <div class="wrap">
    <div class="grid head">
      <p class="meta label col-label" data-reveal>{r.label}</p>
      <h2 id="roadmap-title" class="h2 col-main" data-reveal>{r.title}</h2>
    </div>

    <ol class="phases" role="list">
      {
        r.phases.map((p, i) => (
          <li class="phase" data-s={p.s} data-reveal data-d={i}>
            <div class="rail" aria-hidden="true">
              <span class="node" />
            </div>
            <p class="n mono">
              <span class="sr-only">Phase </span>
              {p.n.padStart(2, '0')}
            </p>
            <span class="pill" data-s={p.s}>
              {legend[p.s]}
            </span>
            <h3>{p.t}</h3>
            <p class="d">{p.d}</p>
          </li>
        ))
      }
    </ol>

    <div class="later">
      <h3 class="meta">{r.later}</h3>
      <ul role="list">
        {r.laterItems.map((x) => <li>{x}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .col-label {
    grid-column: 1 / span 3;
    padding-top: 0.8em;
    align-self: start;
  }
  .col-main {
    grid-column: 4 / span 8;
  }
  .phases {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin: clamp(56px, 7vw, 104px) 0 0;
    padding: 0;
    list-style: none;
  }
  .phase {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding-right: var(--space-5);
  }
  .rail {
    position: relative;
    height: 12px;
    margin-bottom: var(--space-4);
  }
  .rail::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 5.5px;
    height: 1px;
    background: var(--border-strong);
  }
  .phase[data-s='done'] .rail::before {
    background: var(--accent);
  }
  .node {
    position: absolute;
    left: 0;
    top: 0;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--bg-base);
    border: 1px solid var(--border-strong);
  }
  .phase[data-s='done'] .node {
    background: var(--accent);
    border-color: var(--accent);
  }
  .n {
    font-size: 40px;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--text-meta);
  }
  .phase[data-s='done'] .n {
    color: var(--text-primary);
  }
  .pill {
    justify-self: start;
  }
  .phase h3 {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 550;
    letter-spacing: -0.02em;
    margin-top: var(--space-2);
  }
  .d {
    color: var(--text-secondary);
    font-size: var(--fs-ui-sm);
    text-wrap: pretty;
  }
  .later {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-top: clamp(48px, 6vw, 80px);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }
  .later ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .later li {
    padding: 4px 10px;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }
  @media (max-width: 1000px) {
    .col-label,
    .col-main {
      grid-column: 1 / -1;
    }
    .phases {
      grid-template-columns: 1fr;
    }
    .phase {
      grid-template-columns: 24px 1fr;
      column-gap: var(--space-4);
      padding: 0 0 var(--space-6);
    }
    .phase > :not(.rail) {
      grid-column: 2;
    }
    .rail {
      grid-row: 1 / span 4;
      height: auto;
      margin: 0;
    }
    .rail::before {
      left: 5.5px;
      right: auto;
      top: 6px;
      bottom: calc(-1 * var(--space-6));
      width: 1px;
      height: auto;
    }
    .phase:last-child .rail::before {
      display: none;
    }
  }
</style>
