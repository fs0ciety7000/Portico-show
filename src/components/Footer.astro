---
import Brand from './Brand.astro';
import type { Dict } from '../i18n/content.ts';
import { REPO } from '../i18n/content.ts';
import { createGrid, gridToHtml } from '../lib/ascii/grid.ts';
import { renderFooter } from '../lib/ascii/footer.ts';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const f = t.footer;
const grid = createGrid(240, 64);
renderFooter(grid);
const art = gridToHtml(grid);
const home = t.lang === 'fr' ? '/' : '/en/';
---

<footer class="footer" aria-labelledby="footer-title">
  <h2 id="footer-title" class="sr-only">Portico</h2>
  <div class="wrap top">
    <div class="about">
      <Brand href={home} />
      <p class="tagline">{f.tagline}</p>
      <a class="btn btn-ghost gh" href={REPO} rel="noopener">
        github.com/fs0ciety7000/Portico <span class="arrow" aria-hidden="true">↗</span>
      </a>
    </div>
    <nav class="cols" aria-label="Footer">
      {
        f.cols.map((c) => (
          <div class="col">
            <h3 class="meta">{c.t}</h3>
            <ul role="list">
              {c.l.map(([href, label]) => (
                <li>
                  <a href={href} rel={href.startsWith('http') ? 'noopener' : undefined}>
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  <div class="wrap credit">
    <a class="studio" href={f.studioUrl} rel="noopener">
      <span class="dragon" aria-hidden="true"></span>
      <span class="who">
        <span class="meta">{f.credit}</span>
        <span class="name">{f.author}<span class="sep" aria-hidden="true"> · </span><span class="studio-name">{f.studio}</span></span>
      </span>
    </a>
    <div class="legal meta">
      <span>© 2026 Portico</span>
      <span>{f.license}</span>
      <a href="#top" data-top>{f.top} ↑</a>
    </div>
  </div>

  <div class="land" data-land role="img" aria-label={f.landscapeLabel}>
    <pre class="ascii base" aria-hidden="true" set:html={art} />
    <div class="lit" aria-hidden="true"><pre class="ascii" set:html={art} /></div>
  </div>
</footer>

<script>
  const land = document.querySelector<HTMLElement>('[data-land]');
  if (land && window.matchMedia('(hover: hover)').matches) {
    land.addEventListener('pointermove', (e) => {
      const r = land.getBoundingClientRect();
      land.style.setProperty('--lx', `${e.clientX - r.left}px`);
      land.style.setProperty('--ly', `${e.clientY - r.top}px`);
      land.classList.add('lantern');
    });
    land.addEventListener('pointerleave', () => land.classList.remove('lantern'));
  }
  document.querySelector('[data-top]')?.addEventListener('click', (e) => {
    e.preventDefault();
    window.scrollTo({ top: 0 });
    document.querySelector<HTMLElement>('.skip')?.focus({ preventScroll: true });
  });
</script>

<style>
  .footer {
    position: relative;
    padding-top: clamp(80px, 10vw, 144px);
    border-top: 1px solid var(--border-subtle);
    background: var(--bg-base);
    overflow: hidden;
  }
  .top {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-7);
  }
  .about {
    display: grid;
    gap: var(--space-5);
    align-content: start;
    justify-items: start;
  }
  .tagline {
    font-family: var(--font-display);
    font-size: clamp(20px, 1.4vw + 10px, 28px);
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--text-secondary);
    max-width: 26ch;
    text-wrap: balance;
  }
  .gh {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 400;
    height: 40px;
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
  }
  .col h3 {
    color: var(--accent);
    margin-bottom: var(--space-4);
  }
  .col ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-3);
  }
  .col a {
    color: var(--text-secondary);
    font-size: var(--fs-ui);
    transition: color var(--motion-fast) var(--ease-standard);
  }
  .col a:hover {
    color: var(--text-primary);
  }
  .credit {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-5);
    margin-top: clamp(64px, 8vw, 112px);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--border-subtle);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border-subtle);
  }
  .studio {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
  }
  .dragon {
    width: 44px;
    height: 36px;
    flex: none;
    background: var(--text-secondary);
    -webkit-mask: url('/brand/cardor-interactive.svg') center / contain no-repeat;
    mask: url('/brand/cardor-interactive.svg') center / contain no-repeat;
    transition: background-color var(--motion-base) var(--ease-standard);
  }
  .studio:hover .dragon {
    background: var(--text-primary);
  }
  .who {
    display: grid;
    gap: 2px;
  }
  .name {
    font-size: var(--fs-ui);
    font-weight: 550;
  }
  .studio-name {
    color: var(--text-secondary);
    font-weight: 450;
  }
  .sep {
    color: var(--text-muted);
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
  }
  .legal a:hover {
    color: var(--text-primary);
  }

  .land {
    position: relative;
    display: flex;
    justify-content: center;
    margin-top: var(--space-6);
    overflow: hidden;
    font-size: max(calc(100vw / 144), 5px);
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 22%, #000 82%, transparent);
    mask-image: linear-gradient(to bottom, transparent, #000 22%, #000 82%, transparent);
  }
  .land pre {
    flex: none;
    font-size: 1em;
  }
  .lit {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: center;
    opacity: 0;
    -webkit-mask-image: radial-gradient(circle 220px at var(--lx, 50%) var(--ly, 50%), #000 0, #000 35%, transparent 100%);
    mask-image: radial-gradient(circle 220px at var(--lx, 50%) var(--ly, 50%), #000 0, #000 35%, transparent 100%);
    transition: opacity var(--motion-slow) var(--ease-standard);
  }
  .lit pre {
    color: var(--text-primary);
  }
  .lit :global(b) {
    color: var(--accent);
  }
  .land:global(.lantern) .lit {
    opacity: 1;
  }

  @media (max-width: 1000px) {
    .top {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .cols {
      grid-template-columns: 1fr 1fr;
      row-gap: var(--space-6);
    }
  }
</style>
