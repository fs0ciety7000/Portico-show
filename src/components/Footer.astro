---
import Brand from './Brand.astro';
import type { Dict } from '../i18n/content.ts';
import { REPO } from '../i18n/content.ts';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const f = t.footer;
const home = t.lang === 'fr' ? '/' : '/en/';
---

<footer class="footer" aria-labelledby="footer-title">
  <h2 id="footer-title" class="sr-only">Portico</h2>
  <div class="wrap top">
    <div class="about">
      <Brand href={home} />
      <p class="tagline">{f.tagline}</p>
      <a class="btn btn-ghost gh" href={REPO} rel="noopener">
        github.com/fs0ciety7000/Portico <span class="arrow" aria-hidden="true">↗</span>
      </a>
    </div>
    <nav class="cols" aria-label="Footer">
      {
        f.cols.map((c) => (
          <div class="col">
            <h3 class="meta">{c.t}</h3>
            <ul role="list">
              {c.l.map(([href, label]) => (
                <li>
                  <a href={href} rel={href.startsWith('http') ? 'noopener' : undefined}>
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  <div class="wrap credit">
    <a class="studio" href={f.studioUrl} rel="noopener">
      <span class="dragon" aria-hidden="true"></span>
      <span class="who">
        <span class="meta">{f.credit}</span>
        <span class="name">{f.author}<span class="sep" aria-hidden="true"> · </span><span class="studio-name">{f.studio}</span></span>
      </span>
    </a>
    <div class="legal meta">
      <span>© 2026 Portico</span>
      <span>{f.license}</span>
      <a href="#top" data-top>{f.top} ↑</a>
    </div>
  </div>

  <div class="art" data-art role="img" aria-label={f.landscapeLabel}></div>
</footer>

<script>
  // The traveller's lantern: a warm light follows the pointer over the engraving.
  const art = document.querySelector<HTMLElement>('[data-art]');
  if (art && window.matchMedia('(hover: hover)').matches) {
    art.addEventListener('pointermove', (e) => {
      const r = art.getBoundingClientRect();
      art.style.setProperty('--lx', `${((e.clientX - r.left) / r.width) * 100}%`);
      art.style.setProperty('--ly', `${((e.clientY - r.top) / r.height) * 100}%`);
      art.classList.add('lantern');
    });
    art.addEventListener('pointerleave', () => art.classList.remove('lantern'));
  }
  document.querySelector('[data-top]')?.addEventListener('click', (e) => {
    e.preventDefault();
    window.scrollTo({ top: 0 });
    document.querySelector<HTMLElement>('.skip')?.focus({ preventScroll: true });
  });
</script>

<style>
  .footer {
    position: relative;
    padding-top: clamp(80px, 10vw, 144px);
    border-top: 1px solid var(--border-subtle);
    background: var(--bg-base);
    overflow: hidden;
  }
  .top,
  .credit {
    position: relative;
    z-index: 1;
  }
  .top {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-7);
  }
  .about {
    display: grid;
    gap: var(--space-5);
    align-content: start;
    justify-items: start;
  }
  .tagline {
    font-family: var(--font-display);
    font-size: clamp(20px, 1.4vw + 10px, 28px);
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--text-secondary);
    max-width: 26ch;
    text-wrap: balance;
  }
  .gh {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 400;
    height: 40px;
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
  }
  .col h3 {
    color: var(--accent);
    margin-bottom: var(--space-4);
  }
  .col ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-3);
  }
  .col a {
    color: var(--text-secondary);
    font-size: var(--fs-ui);
    transition: color var(--motion-fast) var(--ease-standard);
  }
  .col a:hover {
    color: var(--text-primary);
  }
  .credit {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-5);
    margin-top: clamp(64px, 8vw, 112px);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--border-subtle);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border-subtle);
  }
  .studio {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
  }
  .dragon {
    width: 44px;
    height: 36px;
    flex: none;
    background: var(--text-secondary);
    -webkit-mask: url('/brand/cardor-interactive.svg') center / contain no-repeat;
    mask: url('/brand/cardor-interactive.svg') center / contain no-repeat;
    transition: background-color var(--motion-base) var(--ease-standard);
  }
  .studio:hover .dragon {
    background: var(--text-primary);
  }
  .who {
    display: grid;
    gap: 2px;
  }
  .name {
    font-size: var(--fs-ui);
    font-weight: 550;
  }
  .studio-name {
    color: var(--text-secondary);
    font-weight: 450;
  }
  .sep {
    color: var(--text-meta);
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
  }
  .legal a:hover {
    color: var(--text-primary);
  }

  /*
   * The engraving is a luminance mask: its lines take the theme's colours.
   * Muted mesas, secondary foreground, the accent where the light is (the arch,
   * the lantern, and the pointer on hover).
   */
  .art {
    --lx: 50%;
    --ly: 60%;
    position: relative;
    width: 100%;
    height: max(57.5vw, 340px);
    margin-top: var(--space-6);
    pointer-events: auto;
    background:
      radial-gradient(ellipse 9% 16% at 70% 50%, var(--accent-strong) 0, var(--accent) 45%, transparent 100%),
      radial-gradient(circle at 39% 78%, var(--accent) 0, transparent 5%),
      linear-gradient(to bottom, var(--text-muted) 20%, var(--text-meta) 45%, var(--text-secondary) 85%);
    mask: url('/footer-portico-1536.webp') 62% 100% / cover no-repeat luminance;
    z-index: 0;
  }
  /* Without luminance masks: the engraving itself, screened onto the background. */
  @supports not (mask-mode: luminance) {
    .art {
      background: url('/footer-portico-1536.webp') 62% 100% / cover no-repeat;
      mix-blend-mode: screen;
      opacity: 0.7;
    }
  }
  .art::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle 240px at var(--lx) var(--ly), color-mix(in srgb, var(--accent-strong) 85%, transparent), transparent 70%);
    opacity: 0;
    transition: opacity var(--motion-slow) var(--ease-standard);
  }
  .art:global(.lantern)::after {
    opacity: 1;
  }
  @media (max-width: 900px) {
    .art {
      mask-image: url('/footer-portico-960.webp');
      margin-top: 0;
    }
  }

  @media (max-width: 1000px) {
    .top {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .cols {
      grid-template-columns: 1fr 1fr;
      row-gap: var(--space-6);
    }
  }
</style>
