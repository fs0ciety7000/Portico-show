---
import type { Dict } from '../i18n/content.ts';
import { REPO } from '../i18n/content.ts';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const h = t.hero;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="stage" data-hero-stage>
    <!-- Static fallback (no JS, no WebGL, first paint): the mark with its lit doorway. -->
    <div class="poster" aria-hidden="true">
      <span class="halo"></span>
      <svg viewBox="96 120 320 312" fill="none" stroke="currentColor" stroke-width="22" stroke-linecap="square">
        <path d="M116 150H396M136 186H376M160 186V392M352 186V392M116 412H396"></path>
        <path class="arch" d="M208 392V290A48 48 0 0 1 304 290V392"></path>
      </svg>
    </div>
    <span class="sr-only">{h.sceneLabel}</span>
  </div>

  <div class="wrap grid hero-grid">
    <div class="copy">
      <p class="meta label" data-reveal>{h.eyebrow}</p>
      <h1 id="hero-title" class="title" data-reveal data-d="1">
        <span>{h.title[0]}</span>
        <span class="second">{h.title[1]}</span>
      </h1>
      <p class="lead" data-reveal data-d="2">{h.lead}</p>
      <div class="ctas" data-reveal data-d="3">
        <a class="btn btn-primary" href={REPO} rel="noopener">
          {h.primary}
          <span class="arrow" aria-hidden="true">↗</span>
        </a>
        <a class="btn btn-ghost" href="#installer">
          {h.secondary}
          <kbd aria-hidden="true">↓</kbd>
        </a>
      </div>
      <ul class="tags" role="list" data-reveal data-d="4">
        {
          h.tags.map((tag) => (
            <li>
              <span class="brace">{'{'}</span>{tag.slice(1, -1)}<span class="brace">{'}'}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="wrap foot">
    <a class="scroll meta" href="#principes">
      <span class="scroll-dot" aria-hidden="true"></span>
      {h.scroll}
    </a>
    <p class="meta conn"><span class="status-dot" data-s="connected" aria-hidden="true"></span>{h.figureMeta}</p>
  </div>
</section>

<script>
  const stage = document.querySelector<HTMLElement>('[data-hero-stage]');
  if (stage) {
    // three.js is a separate chunk, fetched once the page is idle.
    const load = () =>
      import('../scripts/hero3d.ts').then(({ mountHero3D }) => {
        mountHero3D(stage, () => stage.classList.add('live'));
      });
    if ('requestIdleCallback' in window) requestIdleCallback(() => void load(), { timeout: 1200 });
    else setTimeout(() => void load(), 300);
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: min(100svh, 1040px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: calc(var(--nav-h) + var(--space-7));
    padding-bottom: var(--space-6);
    overflow: hidden;
    isolation: isolate;
  }
  .stage {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .stage :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity var(--motion-reveal) var(--ease-standard);
  }
  .stage:global(.live) :global(canvas) {
    opacity: 1;
  }
  .stage:global(.live) .poster {
    opacity: 0;
  }
  /* Readability: the copy side fades the scene out. */
  .stage::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, var(--bg-base) 0%, color-mix(in srgb, var(--bg-base) 70%, transparent) 34%, transparent 58%),
      linear-gradient(0deg, var(--bg-base) 0%, transparent 22%);
    pointer-events: none;
  }
  .poster {
    position: absolute;
    right: 9%;
    top: 50%;
    width: min(34vw, 460px);
    aspect-ratio: 1;
    transform: translateY(-46%) perspective(900px) rotateY(-16deg);
    color: color-mix(in srgb, var(--text-secondary) 55%, var(--bg-elevated));
    transition: opacity var(--motion-slow) var(--ease-standard);
  }
  .poster svg {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .poster .arch {
    stroke: var(--accent);
  }
  .halo {
    position: absolute;
    left: 50%;
    top: 62%;
    width: 46%;
    aspect-ratio: 1 / 1.3;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--accent) 55%, transparent), transparent);
  }

  .hero-grid {
    position: relative;
    align-items: center;
  }
  .copy {
    grid-column: 1 / span 6;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-width: 640px;
  }
  .title {
    font-family: var(--font-display);
    font-size: var(--fs-hero);
    font-weight: 500;
    line-height: 0.96;
    letter-spacing: -0.045em;
    margin-top: var(--space-2);
  }
  .title span {
    display: block;
    text-wrap: balance;
  }
  .title .second {
    color: var(--text-secondary);
  }
  .lead {
    max-width: 46ch;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }
  .ctas kbd {
    background: transparent;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }
  .brace {
    color: var(--accent);
  }
  .foot {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    margin-top: clamp(48px, 8vh, 96px);
  }
  .scroll {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    transition: color var(--motion-fast) var(--ease-standard);
  }
  .scroll:hover {
    color: var(--text-primary);
  }
  .scroll-dot {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    position: relative;
  }
  .scroll-dot::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 4px;
    width: 3px;
    height: 3px;
    margin-left: -1.5px;
    border-radius: 50%;
    background: var(--accent);
    animation: drip var(--motion-loop) var(--ease-standard) infinite;
  }
  @keyframes drip {
    to {
      transform: translateY(7px);
      opacity: 0;
    }
  }
  .conn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-transform: none;
    letter-spacing: 0.02em;
  }

  @media (max-width: 1100px) {
    .hero {
      min-height: 0;
      justify-content: flex-start;
      padding-bottom: 0;
    }
    .stage {
      position: relative;
      inset: auto;
      order: 2;
      height: min(92vw, 640px);
      margin-top: calc(-1 * var(--space-6));
    }
    .stage::after {
      background:
        linear-gradient(180deg, var(--bg-base) 0%, transparent 22%),
        linear-gradient(0deg, var(--bg-base) 0%, transparent 18%);
    }
    .poster {
      right: 50%;
      width: min(62vw, 420px);
      transform: translate(50%, -50%);
    }
    .copy {
      grid-column: 1 / -1;
    }
    .foot {
      order: 3;
      margin-top: 0;
      padding-bottom: var(--space-5);
    }
    .scroll {
      display: none;
    }
  }
</style>
