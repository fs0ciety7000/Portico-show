---
import type { Dict } from '../i18n/content.ts';
import { fill, platforms, release, releaseDate, releaseUrl, sumsUrl, version } from '../lib/upstream.ts';
interface Props {
  t: Dict;
}
const { t } = Astro.props;
const i = t.install;
const lang = t.lang as 'fr' | 'en';
const list = platforms(t);
const verifyCmd = `curl -LO ${sumsUrl} && sha256sum -c SHA256SUMS --ignore-missing`;
const extras = [
  { k: i.first.k, cmd: i.first.cmd, note: i.first.note },
  { k: i.verify.k, cmd: verifyCmd, note: i.verify.note },
];
---

<section id="installer" class="section" aria-labelledby="install-title">
  <div class="wrap">
    <div class="grid head">
      <p class="meta label col-label" data-reveal>{i.label}</p>
      <div class="col-main">
        <h2 id="install-title" class="h2" data-reveal>{i.title}</h2>
        <p class="lead" data-reveal data-d="1">{fill(i.lead, { v: version })}</p>
        <p class="release mono" data-reveal data-d="2">
          <span class="ver"><span class="status-dot" data-s="connected" aria-hidden="true"></span>{release?.tag}</span>
          <span class="sep" aria-hidden="true">·</span>
          <span>{releaseDate(lang)}</span>
          <span class="sep" aria-hidden="true">·</span>
          <a href={releaseUrl} rel="noopener">{i.release.notes} <span aria-hidden="true">↗</span></a>
          <span class="sep" aria-hidden="true">·</span>
          <a href={sumsUrl} rel="noopener">{i.release.sums}</a>
        </p>
        <p class="meta synced" data-reveal data-d="2">{i.release.synced}
        </p>
      </div>
    </div>

    <div class="console" data-install>
      <div class="bar">
        <div class="platforms" role="tablist" aria-label={i.label}>
          {
            list.map((p, n) => (
              <button
                type="button"
                role="tab"
                id={`os-tab-${p.id}`}
                aria-controls={`os-${p.id}`}
                aria-selected={n === 0 ? 'true' : 'false'}
                tabindex={n === 0 ? 0 : -1}
                data-os={p.id}
              >
                {p.name}
              </button>
            ))
          }
        </div>
        <a class="all meta" href={releaseUrl} rel="noopener">{i.release.all} <span aria-hidden="true">↗</span></a>
      </div>

      {
        list.map((p, n) => (
          <div class="panel" role="tabpanel" id={`os-${p.id}`} aria-labelledby={`os-tab-${p.id}`} hidden={n !== 0} data-os-panel={p.id}>
            {p.methods.map((m, mi) => (
              <article class="method" data-soon={m.s === 'soon' ? '' : undefined}>
                <header class="m-head">
                  <span class="meta idx">{String(mi + 1).padStart(2, '0')}</span>
                  <h3>{m.k}</h3>
                  <span class="pill" data-s={m.s === 'ok' ? 'done' : 'wip'}>
                    {i.status[m.s]}
                  </span>
                </header>
                <p class="note">{m.note}</p>
                {m.files && (
                  <ul class="files" role="list">
                    {m.files.map((file) => (
                      <li>
                        <a class="file" href={file.href} rel="noopener">
                          <span class="dl" aria-hidden="true">
                            ↓
                          </span>
                          <span class="mono fname">{file.name}</span>
                          <span class="meta">{file.size}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
                {m.steps.length > 0 && (
                <ol class="steps" role="list">
                  {m.steps.map((st) => (
                    <li>
                      <span class="meta step">{st.k}</span>
                      <div class="line">
                        <code tabindex="0">
                          <span class="prompt" aria-hidden="true">
                            $
                          </span>
                          {st.cmd}
                        </code>
                        <button type="button" class="copy" data-copy={st.cmd} data-copied={i.copied} aria-label={`${i.copy} : ${st.cmd}`}>
                          {i.copy}
                        </button>
                      </div>
                    </li>
                  ))}
                </ol>
                )}
              </article>
            ))}
          </div>
        ))
      }
    </div>

    <div class="aside">
      {
        extras.map((b) => (
          <div class="card">
            <h3>{b.k}</h3>
            <div class="line">
              <code tabindex="0">
                <span class="prompt" aria-hidden="true">
                  $
                </span>
                {b.cmd}
              </code>
              <button type="button" class="copy" data-copy={b.cmd} data-copied={i.copied} aria-label={`${i.copy} : ${b.cmd}`}>
                {i.copy}
              </button>
            </div>
            <p class="note">{b.note}</p>
          </div>
        ))
      }
    </div>
    <p class="sr-only" role="status" data-copy-status></p>
  </div>
</section>

<script>
  // Copy buttons.
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
    const label = b.textContent ?? '';
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset['copy'] ?? '');
        b.textContent = b.dataset['copied'] ?? 'OK';
        const status = document.querySelector('[data-copy-status]');
        if (status) status.textContent = `${b.dataset['copied'] ?? ''} : ${b.dataset['copy'] ?? ''}`;
        b.classList.add('done');
        setTimeout(() => {
          b.textContent = label;
          b.classList.remove('done');
        }, 1600);
      } catch {
        /* clipboard refused: the command stays selectable */
      }
    });
  });

  // Platform tabs: roving tabindex, arrows, Home/End; preselect the visitor's OS.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-install] [role="tab"]')];
  const select = (tab: HTMLButtonElement, focus = false) => {
    tabs.forEach((x) => {
      const on = x === tab;
      x.setAttribute('aria-selected', String(on));
      x.tabIndex = on ? 0 : -1;
      const panel = document.querySelector<HTMLElement>(`[data-os-panel="${x.dataset['os']}"]`);
      if (panel) panel.hidden = !on;
    });
    if (focus) tab.focus();
  };
  tabs.forEach((tab, n) => {
    tab.addEventListener('click', () => select(tab));
    tab.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      const edge = e.key === 'Home' ? tabs[0] : e.key === 'End' ? tabs[tabs.length - 1] : undefined;
      const next = edge ?? (d ? tabs[(n + d + tabs.length) % tabs.length] : undefined);
      if (!next) return;
      e.preventDefault();
      select(next, true);
    });
  });
  const ua = navigator.userAgent;
  const guess = /Windows NT/.test(ua)
    ? 'windows'
    : /Mac OS X|Macintosh/.test(ua) && !/iPhone|iPad/.test(ua)
      ? 'macos'
      : /Linux|X11/.test(ua) && !/Android/.test(ua)
        ? 'linux'
        : null;
  const pre = tabs.find((x) => x.dataset['os'] === guess);
  if (pre) select(pre);
</script>

<style>
  .col-label {
    grid-column: 1 / span 3;
    padding-top: 0.8em;
    align-self: start;
  }
  .col-main {
    grid-column: 4 / span 8;
    display: grid;
    gap: var(--space-5);
  }
  .release {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }
  .release a {
    color: var(--text-primary);
    border-bottom: 1px solid var(--border-strong);
    transition: border-color var(--motion-fast) var(--ease-standard);
  }
  .release a:hover {
    border-color: var(--accent);
  }
  .ver {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-primary);
  }
  .sep {
    color: var(--text-meta);
  }
  .synced {
    margin-top: calc(-1 * var(--space-3));
  }

  .console {
    margin-top: clamp(48px, 6vw, 88px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    background: var(--bg-surface);
    overflow: hidden;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--border-subtle);
    background: color-mix(in srgb, var(--bg-base) 40%, var(--bg-surface));
  }
  .platforms {
    display: flex;
    gap: var(--space-1);
  }
  [role='tab'] {
    height: 36px;
    padding-inline: var(--space-4);
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-secondary);
    transition:
      background-color var(--motion-fast) var(--ease-standard),
      color var(--motion-fast) var(--ease-standard);
  }
  [role='tab']:hover {
    color: var(--text-primary);
    background: var(--bg-elevated);
  }
  [role='tab'][aria-selected='true'] {
    color: var(--text-primary);
    background: var(--bg-selected);
    box-shadow: inset 0 -2px 0 var(--accent);
  }
  .all {
    white-space: nowrap;
    transition: color var(--motion-fast) var(--ease-standard);
  }
  .all:hover {
    color: var(--text-primary);
  }
  .panel[hidden] {
    display: none;
  }
  .panel {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    animation: fade var(--motion-slow) var(--ease-standard);
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
  .method {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    min-width: 0;
    padding: var(--space-5);
    border-bottom: 1px solid var(--border-subtle);
  }
  .method:nth-child(odd) {
    border-right: 1px solid var(--border-subtle);
  }
  .panel > .method:only-child {
    grid-column: 1 / -1;
    border-right: 0;
  }
  .m-head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .m-head h3 {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 550;
    letter-spacing: -0.02em;
    margin-right: auto;
  }
  .note {
    font-size: var(--fs-ui-sm);
    color: var(--text-secondary);
    max-width: 62ch;
    text-wrap: pretty;
  }
  .method[data-soon] .line code {
    color: var(--text-secondary);
  }
  .files {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .file {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-strong);
    transition:
      background-color var(--motion-fast) var(--ease-standard),
      border-color var(--motion-fast) var(--ease-standard);
  }
  .file:hover {
    background: var(--bg-elevated);
    border-color: var(--accent);
  }
  .dl {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: var(--text-on-accent);
    font-size: var(--text-sm);
  }
  .fname {
    font-size: var(--text-sm);
    margin-right: auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
  }
  .steps > li {
    min-width: 0;
  }
  .step {
    display: block;
    margin-bottom: var(--space-1);
  }
  .line {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-2) var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--bg-base);
    border: 1px solid var(--border-subtle);
  }
  .line code {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    white-space: nowrap;
    font-size: var(--text-sm);
    line-height: 2;
    color: var(--text-primary);
    user-select: all;
    scrollbar-width: none;
  }
  .prompt {
    color: var(--accent);
    margin-right: var(--space-2);
    user-select: none;
  }
  .copy {
    flex: none;
    height: 28px;
    padding-inline: var(--space-3);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    transition:
      background-color var(--motion-fast) var(--ease-standard),
      color var(--motion-fast) var(--ease-standard);
  }
  .copy:hover {
    background: var(--bg-elevated);
    color: var(--text-primary);
  }
  .copy:global(.done) {
    color: var(--status-connected);
  }
  .aside {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
  .card {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    min-width: 0;
    padding: var(--space-5);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
  }
  .card h3 {
    font-size: var(--fs-ui-lg);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  @media (max-width: 1000px) {
    .col-label,
    .col-main {
      grid-column: 1 / -1;
    }
    .panel,
    .aside {
      grid-template-columns: minmax(0, 1fr);
    }
    .method:nth-child(odd) {
      border-right: 0;
    }
  }
  @media (max-width: 560px) {
    .bar {
      flex-wrap: wrap;
    }
    [role='tab'] {
      padding-inline: var(--space-3);
    }
    .method,
    .card {
      padding: var(--space-4);
    }
  }
</style>
