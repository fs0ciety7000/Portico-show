---
/** The Portico mark (design/portico-mark.svg), stroke only, tinted by `currentColor`. */
interface Props {
  size?: number;
  class?: string;
}
const { size = 24, class: cls } = Astro.props;
---

<svg
  class={cls}
  width={size}
  height={size}
  viewBox="96 120 320 312"
  fill="none"
  stroke="currentColor"
  stroke-width="26"
  stroke-linecap="square"
  aria-hidden="true"
>
  <path d="M116 150 H396" /><path d="M136 186 H376" /><path d="M160 186 V392" /><path d="M352 186 V392" />
  <path d="M208 392 V290 A48 48 0 0 1 304 290 V392" /><path d="M116 412 H396" />
</svg>
