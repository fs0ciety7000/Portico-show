---
import '../styles/tokens.css';
import '../styles/site.css';
import type { Dict } from '../i18n/content.ts';
import { REPO } from '../i18n/content.ts';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
const site = Astro.site ?? new URL('https://portico.dessenius.be');
const path = t.lang === 'fr' ? '/' : '/en/';
const canonical = new URL(path, site).href;
const alt = {
  fr: new URL('/', site).href,
  en: new URL('/en/', site).href,
};
const og = new URL(t.lang === 'fr' ? '/og-fr.png' : '/og-en.png', site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Portico',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Linux',
  description: t.meta.description,
  url: canonical,
  codeRepository: REPO,
  license: 'https://opensource.org/licenses/MIT',
  programmingLanguage: 'Rust',
  inLanguage: t.lang,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  author: {
    '@type': 'Person',
    name: 'Nicolas Dessenius',
    worksFor: { '@type': 'Organization', name: 'Cardor Interactive', url: 'https://interactive.cardormedia.com' },
  },
};
---

<!doctype html>
<html lang={t.lang} data-theme="obsidian">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="fr" href={alt.fr} />
    <link rel="alternate" hreflang="en" href={alt.en} />
    <link rel="alternate" hreflang="x-default" href={alt.fr} />
    <meta name="theme-color" content="#0b0c0e" />
    <meta name="color-scheme" content="dark" />
    <meta name="author" content="Nicolas Dessenius · Cardor Interactive" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/geist.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Portico" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={t.locale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.description} />
    <meta name="twitter:image" content={og} />

    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var th = localStorage.getItem('portico-theme');
          if (th === 'obsidian' || th === 'basalt' || th === 'travertine') d.dataset.theme = th;
        } catch (e) {}
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#contenu">{t.skip}</a>
    <slot />
  </body>
</html>
