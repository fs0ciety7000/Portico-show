---
import Base from '../layouts/Base.astro';
import Brand from '../components/Brand.astro';
import { dict } from '../i18n/content.ts';
const t = dict.fr;
---

<Base t={t}>
  <main id="contenu" class="nf">
    <Brand />
    <pre class="ascii" aria-hidden="true">
<b class="t4">  ssh: Could not resolve hostname</b>
<b class="t3">  ──────────────────────────────── 404</b></pre>
    <h1>Cette page n’existe pas.</h1>
    <p class="muted">This page does not exist.</p>
    <p class="links"><a class="btn btn-primary" href="/">Accueil</a><a class="btn btn-ghost" href="/en/">Home</a></p>
  </main>
</Base>

<style>
  .nf {
    min-height: 100svh;
    display: grid;
    place-content: center;
    justify-items: start;
    gap: var(--space-5);
    padding: var(--gutter);
  }
  .nf pre {
    font-size: 14px;
  }
  h1 {
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: 500;
    letter-spacing: -0.035em;
  }
  .links {
    display: flex;
    gap: var(--space-3);
  }
</style>
